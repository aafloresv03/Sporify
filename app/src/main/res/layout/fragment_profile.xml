<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- HEADER GRADIENT -->
    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/bg_profile_gradient"/>

    <!-- TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:elevation="0dp"/>

    <!-- CARD PERFIL -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/profileCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:layout_marginTop="140dp"
        app:cardElevation="12dp"
        app:cardCornerRadius="28dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="26dp">

            <!-- FOTO -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgAvatar"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:src="@drawable/picture_profile_icon_male_icon_human_or_people_sign_and_symbol_vector"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/Shape.Circular"
                app:strokeColor="@color/colorPrimary"
                app:strokeWidth="4dp"/>

            <!-- CAMBIAR FOTO -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/change_photo"
                app:icon="@drawable/ic_edit"
                app:backgroundTint="@color/colorPrimary"
                android:textColor="@color/colorOnPrimary"/>

            <!-- NOMBRE -->
            <TextView
                android:id="@+id/txtName"
                android:layout_marginTop="24dp"
                android:text="@string/name"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurface"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- EMAIL -->
            <TextView
                android:id="@+id/txtAlias"
                android:layout_marginTop="4dp"
                android:text="@string/emailText"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- SEPARADOR -->
            <View
                android:layout_marginTop="24dp"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorPrimary"/>

            <!-- ESTADO SPOTIFY -->
            <TextView
                android:id="@+id/tvSpotifyStatus"
                android:layout_marginTop="20dp"
                android:text="Spotify no conectado"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/colorOnSurface"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- BOTON SPOTIFY -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpotifyConnect"
                android:layout_marginTop="12dp"
                android:text="Conectar Spotify"
                app:backgroundTint="#1DB954"
                android:textColor="@android:color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>