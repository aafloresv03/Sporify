<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Home">

    <!-- 🟦 FONDO DINÁMICO (siempre detrás) -->
    <FrameLayout
        android:id="@+id/playerBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_player_default"
        android:elevation="0dp" />

    <!-- 🟧 MINI PLAYER -->
    <include
        android:id="@+id/miniPlayer"
        layout="@layout/component_mini_player"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="130dp"
        android:elevation="6dp"/>

    <!-- 🟩 CONTENEDOR DEL FRAGMENT -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="215dp"
        android:paddingTop="5dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:elevation="2dp"/>

    <!-- 🟥 BOTTOM NAVIGATION -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="bottom"
        android:background="@color/colorSurface"
        android:elevation="8dp"
        app:itemIconTint="@color/colorPrimaryVariant"
        app:itemTextColor="@color/colorOnSurface"
        app:menu="@menu/menu_bottom"
        app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
